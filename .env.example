# Meta Tech Provider & WhatsApp Cloud API Credentials
NEXT_PUBLIC_META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
NEXT_PUBLIC_META_CONFIG_ID="your_meta_embedded_signup_config_id"
META_SYSTEM_USER_TOKEN="your_permanent_system_user_token"
META_GRAPH_API_VERSION="v21.0"

# Local development only. Never enable in production; mock delivery is off by default.
ALLOW_META_MOCKS="false"

# Authentication (minimum 32 random characters; keep server-side only)
AUTH_SESSION_SECRET="replace_with_a_random_secret_of_at_least_32_characters"

# Neon Managed Better Auth and Lakebase Postgres
NEON_AUTH_BASE_URL="https://your-branch-auth-url.example/neondb/auth"
NEON_AUTH_COOKIE_SECRET="replace_with_a_random_cookie_secret_of_at_least_32_characters"
DATABASE_URL="postgresql://user:password@host-pooler/database?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/database?sslmode=require"

# Webhook Verification
META_WEBHOOK_VERIFY_TOKEN="replace_with_a_random_webhook_verify_token"

# Security: AES-256-GCM Master Key for Token Encryption at Rest (32 characters or random salt)
ENCRYPTION_KEY="replace_with_a_managed_secret_of_at_least_32_characters"

# Strapi Headless CMS Backend
STRAPI_INTERNAL_URL="http://localhost:1337"
STRAPI_API_TOKEN="your_strapi_full_access_or_custom_token"
USE_REAL_STRAPI="false"
