# Meta Tech Provider & WhatsApp Cloud API Credentials
NEXT_PUBLIC_META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
NEXT_PUBLIC_META_CONFIG_ID="your_meta_embedded_signup_config_id"
META_SYSTEM_USER_TOKEN="your_permanent_system_user_token"
META_GRAPH_API_VERSION="v21.0"

# Webhook Verification
META_WEBHOOK_VERIFY_TOKEN="thynkwise_meta_verify_token_secure_2026"

# Security: AES-256-GCM Master Key for Token Encryption at Rest (32 characters or random salt)
ENCRYPTION_KEY="thynkwise-super-secure-aes256-encryption-master-key-2026"

# Strapi Headless CMS Backend
STRAPI_INTERNAL_URL="http://localhost:1337"
STRAPI_API_TOKEN="your_strapi_full_access_or_custom_token"
USE_REAL_STRAPI="false"
