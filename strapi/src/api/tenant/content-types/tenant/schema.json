{
  "kind": "collectionType",
  "collectionName": "tenants",
  "info": {
    "singularName": "tenant",
    "pluralName": "tenants",
    "displayName": "Tenant",
    "description": "Multi-tenant enterprise organization"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "suspended", "trial"],
      "default": "trial"
    },
    "plan": {
      "type": "enumeration",
      "enum": ["starter", "growth", "enterprise"],
      "default": "starter"
    },
    "wabas": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::waba.waba",
      "mappedBy": "tenant"
    },
    "contacts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::contact.contact",
      "mappedBy": "tenant"
    },
    "conversations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::conversation.conversation",
      "mappedBy": "tenant"
    }
  }
}
